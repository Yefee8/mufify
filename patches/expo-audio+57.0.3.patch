@@ -0,0 +1,79 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!--
+  Mufify's media notification, collapsed: cover, title, artist, three buttons.
+
+  Inflated by the system inside its own decorated frame (app name, time, the
+  chevron), so no header of our own. 48dp tall, which is what Android 12 gives
+  a collapsed custom view; taller would be clipped there and is not needed. Text uses the compat notification styles,
+  which the system recolours for a dark or a light notification; the buttons
+  are recoloured from code for the same reason. Only used on Android 12 and
+  below — 13 and later draw media notifications from the session alone.
+-->
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+  android:layout_width="match_parent"
+  android:layout_height="48dp"
+  android:orientation="horizontal"
+  android:gravity="center_vertical"
+  android:paddingStart="12dp"
+  android:paddingEnd="4dp">
+
+  <ImageView
+    android:id="@+id/mufify_artwork"
+    android:layout_width="40dp"
+    android:layout_height="40dp"
+    android:scaleType="centerCrop"
+    android:contentDescription="@null" />
+
+  <LinearLayout
+    android:layout_width="0dp"
+    android:layout_height="wrap_content"
+    android:layout_weight="1"
+    android:layout_marginStart="12dp"
+    android:layout_marginEnd="4dp"
+    android:orientation="vertical">
+
+    <TextView
+      android:id="@+id/mufify_title"
+      android:layout_width="match_parent"
+      android:layout_height="wrap_content"
+      android:singleLine="true"
+      android:ellipsize="end"
+      android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />
+
+    <TextView
+      android:id="@+id/mufify_artist"
+      android:layout_width="match_parent"
+      android:layout_height="wrap_content"
+      android:singleLine="true"
+      android:ellipsize="end"
+      android:textAppearance="@style/TextAppearance.Compat.Notification.Line2" />
+  </LinearLayout>
+
+  <ImageView
+    android:id="@+id/mufify_previous"
+    android:layout_width="36dp"
+    android:layout_height="36dp"
+    android:padding="7dp"
+    android:src="@drawable/media3_icon_previous"
+    android:contentDescription="@string/mufify_notification_previous" />
+
+  <ImageView
+    android:id="@+id/mufify_play_pause"
+    android:layout_width="40dp"
+    android:layout_height="40dp"
+    android:layout_marginStart="4dp"
+    android:layout_marginEnd="4dp"
+    android:padding="8dp"
+    android:background="@drawable/mufify_notification_play_bg"
+    android:src="@drawable/media3_icon_pause"
+    android:tint="#FFFFFF"
+    android:contentDescription="@string/mufify_notification_pause" />
+
+  <ImageView
+    android:id="@+id/mufify_next"
+    android:layout_width="36dp"
+    android:layout_height="36dp"
+    android:padding="7dp"
+    android:src="@drawable/media3_icon_next"
+    android:contentDescription="@string/mufify_notification_next" />
+</LinearLayout>
