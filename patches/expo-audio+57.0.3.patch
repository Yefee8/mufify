+<?xml version="1.0" encoding="utf-8"?>
+<!-- The expanded form: a bigger cover, the album as a third line, and the
+     same three buttons at a size a thumb can find. See the collapsed layout. -->
+<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
+  android:layout_width="match_parent"
+  android:layout_height="wrap_content"
+  android:orientation="horizontal"
+  android:gravity="center_vertical"
+  android:paddingStart="12dp"
+  android:paddingEnd="12dp"
+  android:paddingTop="8dp"
+  android:paddingBottom="8dp">
+
+  <ImageView
+    android:id="@+id/mufify_artwork"
+    android:layout_width="96dp"
+    android:layout_height="96dp"
+    android:scaleType="centerCrop"
+    android:contentDescription="@null" />
+
+  <LinearLayout
+    android:layout_width="0dp"
+    android:layout_height="wrap_content"
+    android:layout_weight="1"
+    android:layout_marginStart="14dp"
+    android:orientation="vertical">
+
+    <TextView
+      android:id="@+id/mufify_title"
+      android:layout_width="match_parent"
+      android:layout_height="wrap_content"
+      android:singleLine="true"
+      android:ellipsize="end"
+      android:textAppearance="@style/TextAppearance.Compat.Notification.Title" />
+
+    <TextView
+      android:id="@+id/mufify_artist"
+      android:layout_width="match_parent"
+      android:layout_height="wrap_content"
+      android:singleLine="true"
+      android:ellipsize="end"
+      android:textAppearance="@style/TextAppearance.Compat.Notification.Line2" />
+
+    <TextView
+      android:id="@+id/mufify_album"
+      android:layout_width="match_parent"
+      android:layout_height="wrap_content"
+      android:singleLine="true"
+      android:ellipsize="end"
+      android:textAppearance="@style/TextAppearance.Compat.Notification.Info" />
+
+    <LinearLayout
+      android:layout_width="match_parent"
+      android:layout_height="wrap_content"
+      android:layout_marginTop="8dp"
+      android:orientation="horizontal"
+      android:gravity="center_vertical">
+
+      <ImageView
+        android:id="@+id/mufify_previous"
+        android:layout_width="44dp"
+        android:layout_height="44dp"
+        android:padding="10dp"
+        android:src="@drawable/media3_icon_previous"
+            android:contentDescription="@string/mufify_notification_previous" />
+
+      <ImageView
+        android:id="@+id/mufify_play_pause"
+        android:layout_width="44dp"
+        android:layout_height="44dp"
+        android:layout_marginStart="12dp"
+        android:layout_marginEnd="12dp"
+        android:padding="10dp"
+        android:background="@drawable/mufify_notification_play_bg"
+        android:src="@drawable/media3_icon_pause"
+        android:tint="#FFFFFF"
+        android:contentDescription="@string/mufify_notification_pause" />
+
+      <ImageView
+        android:id="@+id/mufify_next"
+        android:layout_width="44dp"
+        android:layout_height="44dp"
+        android:padding="10dp"
+        android:src="@drawable/media3_icon_next"
+            android:contentDescription="@string/mufify_notification_next" />
+    </LinearLayout>
+  </LinearLayout>
+</LinearLayout>
